# Copy to `.env` and adjust. Every value is optional — the defaults in
# config.py are used when a variable is unset. There are no secrets here;
# the simulator needs no API keys or accounts.

# Where checkpoints are written and read from
RACE_SIM_MODEL_DIR=models
RACE_SIM_BEST_MODEL=models/best.pt

# Per-generation CSV training logs
RACE_SIM_LOG_DIR=logs

# Generations between numbered snapshots (models/gen_<n>.pt); 0 disables them
RACE_SIM_CHECKPOINT_EVERY=50

# Physics ticks drawn per frame when the visualiser is in fast-forward mode
RACE_SIM_FAST_STEPS=500

# Fixed seed for reproducible runs; leave unset (or negative) for random
RACE_SIM_SEED=-1
